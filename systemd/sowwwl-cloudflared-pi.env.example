# Preferred: point to a root-only token file.
CLOUDFLARED_TUNNEL_TOKEN_FILE=/etc/sowwwl/cloudflared-pi.token

# Fallback: direct token value when a token file is not used.
# Keep this secret outside git.
CLOUDFLARED_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARED_TUNNEL_TOKEN

# Optional cloudflared log level: debug, info, warn, error
CLOUDFLARED_LOGLEVEL=info
