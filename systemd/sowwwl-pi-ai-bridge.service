[Unit]
Description=sowwwl pocket-land AI bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{RUN_USER}}
Group={{RUN_GROUP}}
WorkingDirectory=/var/lib/sowwwl
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/sowwwl/pocket-land.env
ExecStart=/usr/bin/python3 {{REPO_DIR}}/scripts/sowwwl-pi-ai-bridge.py
Restart=on-failure
RestartSec=5
StateDirectory=sowwwl
StateDirectoryMode=0755
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
