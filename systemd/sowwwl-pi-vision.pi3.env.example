# Physical trace uplink for a separate Raspberry Pi 3 camera node.
# If the public host later moves away from pi.sowwwl.cloud, update this URL too.
SOWWWL_PI_ENDPOINT=https://pi.sowwwl.cloud/ingest/sensor
SOWWWL_PI_TOKEN=CHANGE_ME_PI_TOKEN
SOWWWL_PI_LAND_SLUG=pi3-camera-01

# Camera selection.
SOWWWL_PI_CAMERAS=0

# Pi 3 friendly defaults.
SOWWWL_PI_WIDTH=640
SOWWWL_PI_HEIGHT=480
SOWWWL_PI_FRAMERATE=8
SOWWWL_PI_MIN_AREA=1200
SOWWWL_PI_COOLDOWN_SECONDS=5
SOWWWL_PI_TIMEOUT_SECONDS=4
SOWWWL_PI_REPLAY_INTERVAL_SECONDS=20
SOWWWL_PI_MAX_REPLAY_BATCH=24

# Local offline spool.
SOWWWL_PI_SPOOL=/var/lib/sowwwl/plasma-spool.jsonl

# Optional local MJPEG viewer.
# Set SOWWWL_PI_STREAM_ENABLED=1 to open a live LAN stream.
# Leave SOWWWL_PI_STREAM_TOKEN empty for a LAN-only unprotected stream,
# or set a random token and append ?token=... when opening the URL.
# SOWWWL_PI_STREAM_ENABLED=1
# SOWWWL_PI_STREAM_BIND=0.0.0.0
# SOWWWL_PI_STREAM_PORT=8082
# SOWWWL_PI_STREAM_TOKEN=
# SOWWWL_PI_STREAM_MAX_FPS=4
# SOWWWL_PI_STREAM_JPEG_QUALITY=72
