# Physical trace uplink.
# Start with the public host you actually expose. For the first Pi-backed host,
# that can be https://pi.sowwwl.cloud/ingest/sensor before a later cutover.
SOWWWL_PI_ENDPOINT=https://lab.sowwwl.cloud/ingest/sensor
SOWWWL_PI_TOKEN=CHANGE_ME_PI_TOKEN
SOWWWL_PI_LAND_SLUG=pi-pocket-01

# Camera selection.
SOWWWL_PI_CAMERAS=0

# Vision tuning.
SOWWWL_PI_WIDTH=640
SOWWWL_PI_HEIGHT=480
SOWWWL_PI_FRAMERATE=12
SOWWWL_PI_MIN_AREA=1500
SOWWWL_PI_COOLDOWN_SECONDS=4
SOWWWL_PI_TIMEOUT_SECONDS=2.5
SOWWWL_PI_REPLAY_INTERVAL_SECONDS=20
SOWWWL_PI_MAX_REPLAY_BATCH=24

# Local offline spool.
SOWWWL_PI_SPOOL=/var/lib/sowwwl/plasma-spool.jsonl
